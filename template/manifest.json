{
  "id": "my-plugin",
  "name": "My Plugin",
  "version": "0.1.0",
  "schemaVersion": 1,
  "minAppVersion": "0.6.5",
  "requires": {
    "domains": {
      "library": "^1.35.0",
      "reading": "^2.24.0"
    },
    "contributions": {
      "commands": "^1.1.0",
      "selectionActions": "^1.2.0",
      "headerActions": "^1.2.0"
    },
    "services": {
      "storage": "^2.6.0"
    },
    "schemas": {
      "views": "^1.12.0",
      "settings": "^1.0.0"
    }
  },
  "description": "One sentence about what it does.",
  "author": "you",
  "permissions": [
    "library:read",
    "reading:write"
  ],
  "main": "main.js",
  "settings": [
    {
      "kind": "text",
      "id": "greeting",
      "label": {
        "default": "Greeting",
        "translations": {
          "zh-Hans": "问候语"
        }
      },
      "value": "Hello",
      "helperText": "Shown by the hello command — labels accept localized bundles."
    }
  ]
}
