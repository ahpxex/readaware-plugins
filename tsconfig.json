{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@readaware/plugin-api": [
        "types/plugin-api.d.ts"
      ]
    }
  },
  "include": [
    "types",
    "plugins/*/src",
    "template/src"
  ]
}
